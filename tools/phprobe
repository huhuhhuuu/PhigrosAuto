#!/bin/sh
# phprobe —— PhigrosAuto 一键诊断
#
# 随插件安装，终端直接敲：phprobe
#
# 曾经的两个误报（已修）：
#   1) 二进制 plist 的字符串以 NUL 分隔、没有换行，直接 grep 会读到
#      相邻字段，误报出 com.apple.compilers.llvm.clang.1_0
#   2) ls -l "$DIR" | grep 在某些 shell 下拿不到稳定输出，
#      改用纯 shell 的 glob 匹配，不依赖 ls 的格式

DL=/var/jb/Library/MobileSubstrate/DynamicLibraries
TI=/var/jb/usr/lib/TweakInject
MARK_DIRS="/var/mobile/Containers/Data/Application"
BID=""
PLIST_BID=""
BID_MISMATCH=0
INJECTED=0
GAME_UP=0
PROBE_OK=0
LOGS=""
MARKERS=""
RH_HITS=""

echo "=============================================="
echo " PhigrosAuto 诊断 v1.8"
echo "=============================================="

# ---------- 1. 版本 ----------
echo
echo "[1] 已安装版本"
VER="(未知)"
for f in /var/jb/var/lib/dpkg/status /var/lib/dpkg/status; do
  [ -f "$f" ] || continue
  V=$(awk '/^Package: com\.yg\.phigrosauto$/{f=1} f&&/^Version:/{print $2; exit}' "$f" 2>/dev/null)
  if [ -n "$V" ]; then VER="$V"; break; fi
done
echo "    Version: $VER"
if [ -f "$DL/PhigrosAuto.dylib" ]; then
  echo "    dylib  : $(ls -l "$DL/PhigrosAuto.dylib" 2>/dev/null | awk '{print $5" bytes  "$6" "$7" "$8}')"
else
  echo "    !! dylib 不在 $DL"
fi

# ---------- 2. 两个注入目录的实况（关键） ----------
echo
echo "[2] 注入目录实况"
echo "    --- $DL ---"
if [ -d "$DL" ]; then
  echo "    (符号链接 -> $(readlink "$DL" 2>/dev/null || echo '非链接'))"
  N=0
  for f in "$DL"/*; do
    [ -e "$f" ] || continue
    N=$((N+1))
    case "$f" in
      *[Pp]higros*) echo "    >>> $(basename "$f")" ;;
      *) echo "        $(basename "$f")" ;;
    esac
  done
  echo "    共 $N 项"
else
  echo "    !! 目录不存在"
fi

echo "    --- $TI ---"
if [ -d "$TI" ]; then
  echo "    (符号链接 -> $(readlink "$TI" 2>/dev/null || echo '非链接'))"
  for f in "$TI"/*; do
    [ -e "$f" ] || continue
    case "$f" in
      *[Pp]higros*) echo "    >>> $(basename "$f")" ;;
    esac
  done
else
  echo "    不存在（正常，多数设备只用 DynamicLibraries）"
fi

# RootHide 补丁目录：装过 RootHide 的机器会把 dylib 重定位到这里
echo "    --- /var/jb/usr/lib/DynamicPatches ---"
if [ -d /var/jb/usr/lib/DynamicPatches ]; then
  for f in /var/jb/usr/lib/DynamicPatches/*; do
    [ -e "$f" ] || continue
    case "$f" in
      *[Pp]higros*) echo "    >>> $(basename "$f")" ;;
    esac
  done
  echo "    （RootHide 已启用：dylib 可能被重定位到此处）"
else
  echo "    不存在"
fi

# ---------- 3. filter plist ----------
echo
echo "[3] filter plist"
PLIST_F="$DL/PhigrosAuto.plist"
if [ -f "$PLIST_F" ]; then
  # 用 tr 把 NUL 换成换行，二进制/XML 都能读
  tr '\0' '\n' < "$PLIST_F" 2>/dev/null | grep -o 'com\.[A-Za-z0-9._-]*' | head -3
  PLIST_BID=$(tr '\0' '\n' < "$PLIST_F" 2>/dev/null | grep -o 'com\.[A-Za-z0-9._-]*' | head -1)
  echo "    解析出 Bundle = ${PLIST_BID:-(未取到)}"
else
  echo "    !! plist 不存在 —— 没有它 ElleKit 不会注入任何进程"
fi
[ -f "$DL/PhigrosAuto.plist.disabled" ] && echo "    !! 存在 .disabled，插件被禁用"
[ -f "$DL/PhigrosAuto.dylib.disabled" ] && echo "    !! dylib 被加了 .disabled"

# ---------- 4. 游戏真实 bundle id ----------
echo
echo "[4] 游戏真实 bundle id"
APPBIN=""
for p in /var/containers/Bundle/Application/*/Phigros.app/Phigros \
         /private/var/containers/Bundle/Application/*/Phigros.app/Phigros ; do
  [ -f "$p" ] && APPBIN="$p"
done
if [ -n "$APPBIN" ]; then
  APP_DIR=$(dirname "$APPBIN")
  echo "    路径: $APP_DIR"
  INFO="$APP_DIR/Info.plist"
  # 依次尝试：plutil → 去 NUL 后按关键字抓 → strings
  if command -v plutil >/dev/null 2>&1; then
    BID=$(plutil -extract CFBundleIdentifier raw "$INFO" 2>/dev/null)
  fi
  if [ -z "$BID" ]; then
    BID=$(tr -d '\0' < "$INFO" 2>/dev/null \
          | grep -aoE 'com\.[A-Za-z0-9._-]*[Pp]higros[A-Za-z0-9._-]*' | head -1)
  fi
  if [ -z "$BID" ]; then
    BID=$(tr -d '\0' < "$INFO" 2>/dev/null \
          | grep -aoE 'com\.[A-Za-z0-9._-]*' | grep -v -i 'apple' | head -1)
  fi
  echo "    CFBundleIdentifier = ${BID:-(仍读不出，可忽略：不影响判断)}"
  if [ -n "$BID" ] && [ -n "$PLIST_BID" ]; then
    if [ "$BID" != "$PLIST_BID" ]; then
      echo "    !!! 不匹配：plist=$PLIST_BID 实际=$BID"
      BID_MISMATCH=1
    else
      echo "    匹配 OK"
    fi
  fi
else
  echo "    找不到 Phigros.app"
fi

# ---------- 5. RootHide / 隐藏相关 ----------
echo
echo "[5] RootHide 相关"
ls -d /var/jb/Library/RootHide 2>/dev/null >/dev/null \
  && echo "    /var/jb/Library/RootHide 存在" \
  || echo "    /var/jb/Library/RootHide 不存在"
for p in /var/jb/usr/lib/AutoPatches.dylib \
         /var/jb/usr/lib/DynamicPatches/AutoPatches.dylib \
         /var/jb/usr/lib/librootHide.dylib ; do
  [ -e "$p" ] && echo "    存在 $p"
done
# 偏好文件里出现 Phigros 字样 = 极可能被列进隐藏名单
for p in /var/mobile/Library/Preferences/*.plist /var/jb/var/mobile/Library/Preferences/*.plist; do
  [ -f "$p" ] || continue
  if tr -d '\0' < "$p" 2>/dev/null | grep -qai 'phigros'; then
    echo "    !! $(basename "$p") 里出现 Phigros"
    RH_HITS="$RH_HITS $p"
  fi
done
[ -z "$RH_HITS" ] && echo "    偏好文件里没发现 Phigros"

# ---------- 6. 心跳标记 ----------
echo
echo "[6] 心跳标记（判断 dylib 有没有真的执行）"
for p in "$MARK_DIRS"/*/tmp/PhigrosAuto.marker; do
  [ -f "$p" ] && MARKERS="$MARKERS $p"
done
for p in /var/mobile/Media/PhigrosAuto.marker /tmp/PhigrosAuto.marker; do
  [ -f "$p" ] && MARKERS="$MARKERS $p"
done
if [ -n "$MARKERS" ]; then
  for p in $MARKERS; do
    echo "    [游戏] $p"
    echo "           $(tail -1 "$p" 2>/dev/null)"
  done
  INJECTED=1
else
  echo "    [游戏] 没有 => PhigrosAuto 未进入游戏进程"
fi

# 对照探针：装在 SpringBoard，与游戏无关
PROBE_MARK=""
for p in /var/mobile/Media/PHProbe.marker /tmp/PHProbe.marker; do
  [ -f "$p" ] && PROBE_MARK="$p"
done
if [ -n "$PROBE_MARK" ]; then
  echo "    [桌面] $PROBE_MARK"
  echo "           $(tail -1 "$PROBE_MARK" 2>/dev/null)"
  PROBE_OK=1
else
  echo "    [桌面] 没有 => 连 SpringBoard 都没注入"
  PROBE_OK=0
fi

# ---------- 7. 日志 ----------
echo
echo "[7] 日志文件"
for p in "$MARK_DIRS"/*/Documents/PhigrosAuto.log; do
  [ -f "$p" ] && LOGS="$LOGS $p"
done
for p in /var/mobile/Media/PhigrosAuto.log /var/mobile/PhigrosAuto.log /tmp/PhigrosAuto.log; do
  [ -f "$p" ] && LOGS="$LOGS $p"
done
if [ -n "$LOGS" ]; then
  for p in $LOGS; do
    echo "    ---- $p ----"
    tail -40 "$p"
    echo "    ---- end ----"
  done
else
  echo "    没有日志文件"
fi

# ---------- 8. 游戏进程 ----------
echo
echo "[8] 游戏进程"
if killall -0 Phigros 2>/dev/null; then
  echo "    Phigros 正在运行"
  GAME_UP=1
else
  echo "    Phigros 没在运行"
fi

# ---------- 9. 已装的相关包 ----------
echo
echo "[9] dpkg 里与注入相关的包"
for f in /var/jb/var/lib/dpkg/status /var/lib/dpkg/status; do
  [ -f "$f" ] || continue
  awk '/^Package: /{p=$2} /^Version: /{v=$2; if (p ~ /ellekit|substrate|roothide|phigros|inject/) print "    "p" "v}' "$f" 2>/dev/null | sort -u
  break
done

# ---------- 结论 ----------
echo
echo "=============================================="
echo " 结论"
echo "=============================================="
if [ "$GAME_UP" = "0" ]; then
  echo " 游戏没开。打开 Phigros 停在主界面，再跑一次 phprobe。"
elif [ "$INJECTED" = "1" ]; then
  echo " A) dylib 已注入并执行 —— 注入链路正常。"
  [ -n "$LOGS" ] && echo "    看第 7 节日志判断卡在哪。" \
                 || echo "    日志没写成功，但心跳已证明注入 OK。"
elif [ "$PROBE_OK" = "1" ]; then
  echo " C) 注入链正常（桌面探针已写入），但游戏没被注入。"
  echo
  echo "    这排除了 ElleKit 本身的问题，问题只可能在 Phigros 这一侧："
  echo "      · filter 里的 bundle id 与游戏实际 id 不一致"
  echo "      · RootHide 把 Phigros 列入隐藏名单，主动抑制注入"
  echo "      · 游戏是从后台恢复的，不是冷启动"
  echo
  if [ "$BID_MISMATCH" = "1" ]; then
    echo "    ★ 已确认 bundle id 不匹配：plist=$PLIST_BID 实际=$BID"
    echo "      把实际值发我，我改完重新打包。"
  else
    echo "    第 4 节若显示「仍读不出」，请手动执行这条并把输出发我："
    echo "      tr -d '\\0' < /var/containers/Bundle/Application/*/Phigros.app/Info.plist | grep -ao 'com\\.[A-Za-z0-9._-]*' | grep -vi apple | head"
  fi
  if [ -n "$RH_HITS" ]; then
    echo
    echo "    ★ RootHide 偏好里出现了 Phigros（第 5 节），"
    echo "      去 RootHide 设置里把它移出隐藏名单。"
  fi
else
  echo " D) 连 SpringBoard 都没被注入 —— 注入链本身没工作。"
  echo
  echo "    这时与你写的插件代码完全无关。按顺序查："
  echo "      1. ElleKit 装了吗："
  echo "         dpkg -l | grep -i ellekit"
  echo "      2. 桌面确实重启过吗：killall -9 SpringBoard 之后等 10 秒"
  echo "      3. DynamicLibraries 是否被指向了不存在的目录（看第 2 节的链接）"
  echo "      4. 若装了 RootHide，先把它整个关掉再测"
fi
echo "=============================================="
