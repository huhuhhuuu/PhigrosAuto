#!/bin/sh
# phprobe —— PhigrosAuto 一键诊断
#
# 随插件一起安装，装完直接在终端敲：
#   phprobe
#
# 结论只有三种，末尾会直接告诉你属于哪一种。

MARK_TMP_DIR=/var/mobile/Containers/Data/Application
DL=/var/jb/Library/MobileSubstrate/DynamicLibraries
BID_MISMATCH=0
BID=""
PLIST_BID=""

echo "=============================================="
echo " PhigrosAuto 诊断"
echo "=============================================="

# ---------- 1. 版本 ----------
echo
echo "[1] 已安装版本"
VER="(未知)"
for f in /var/jb/var/lib/dpkg/status /var/lib/dpkg/status; do
  [ -f "$f" ] || continue
  V=$(awk '/^Package: com\.yg\.phigrosauto$/{f=1} f&&/^Version:/{print $2; exit}' "$f" 2>/dev/null)
  [ -n "$V" ] && VER="$V" && break
done
echo "    Version: $VER"
echo "    dylib  : $(ls -l "$DL/PhigrosAuto.dylib" 2>/dev/null | awk '{print $5" bytes  "$6" "$7" "$8}')"

# ---------- 2. 注入器 ----------
echo
echo "[2] 注入器文件"
FOUND_INJ=0
for f in /var/jb/usr/lib/libellekit.dylib \
         /var/jb/usr/lib/libsubstrate.dylib \
         /var/jb/Library/Frameworks/CydiaSubstrate.framework/CydiaSubstrate ; do
  if [ -f "$f" ]; then echo "    OK  $f"; FOUND_INJ=1; fi
done
[ "$FOUND_INJ" = "0" ] && echo "    !! 没找到注入器，ElleKit 可能没装"

# ---------- 3. 原始心跳标记（最关键） ----------
echo
echo "[3] 心跳标记（判断 dylib 有没有真的执行）"
MARKERS=""
for p in "$MARK_TMP_DIR"/*/tmp/PhigrosAuto.marker ; do
  [ -f "$p" ] && MARKERS="$MARKERS $p"
done
for p in /var/mobile/Media/PhigrosAuto.marker /tmp/PhigrosAuto.marker ; do
  [ -f "$p" ] && MARKERS="$MARKERS $p"
done

if [ -n "$MARKERS" ]; then
  echo "    找到标记:"
  for p in $MARKERS ; do
    echo "      $p"
    echo "      最后一条: $(tail -1 "$p" 2>/dev/null)"
  done
  INJECTED=1
else
  echo "    没有任何心跳标记"
  echo "    => dylib 没有进入游戏进程，或 constructor 未执行"
  INJECTED=0
fi

# ---------- 4. 日志 ----------
echo
echo "[4] 日志文件"
LOGS=""
for p in "$MARK_TMP_DIR"/*/Documents/PhigrosAuto.log ; do
  [ -f "$p" ] && LOGS="$LOGS $p"
done
for p in /var/mobile/Media/PhigrosAuto.log /var/mobile/PhigrosAuto.log /tmp/PhigrosAuto.log ; do
  [ -f "$p" ] && LOGS="$LOGS $p"
done

if [ -n "$LOGS" ]; then
  for p in $LOGS ; do
    echo "    ---- $p ----"
    cat "$p"
    echo "    ---- end ----"
  done
else
  echo "    没有日志文件"
fi

# ---------- 5. 游戏进程 ----------
echo
echo "[5] 游戏进程"
if killall -0 Phigros 2>/dev/null; then
  echo "    Phigros 正在运行"
  GAME_UP=1
else
  echo "    Phigros 没在运行"
  GAME_UP=0
fi

# ---------- 5b. 真实 bundle id（关键） ----------
echo
echo "[5b] 游戏真实 bundle id（对照 plist 的 Filter）"
APPBIN=""
for p in /var/containers/Bundle/Application/*/Phigros.app/Phigros \
         /private/var/containers/Bundle/Application/*/Phigros.app/Phigros ; do
  [ -f "$p" ] && APPBIN="$p"
done

if [ -n "$APPBIN" ]; then
  APP_DIR=$(dirname "$APPBIN")
  echo "    路径: $APP_DIR"
  # Info.plist 可能是二进制格式，优先 plutil，没有就 strings 兜底
  if command -v plutil >/dev/null 2>&1; then
    BID=$(plutil -extract CFBundleIdentifier raw "$APP_DIR/Info.plist" 2>/dev/null)
  fi
  if [ -z "$BID" ]; then
    BID=$(strings "$APP_DIR/Info.plist" 2>/dev/null | grep -E '^[a-zA-Z0-9]+\.[a-zA-Z0-9.-]+$' | head -1)
  fi
  [ -z "$BID" ] && BID=$(grep -a -o 'com\.[A-Za-z0-9._-]*' "$APP_DIR/Info.plist" 2>/dev/null | head -1)
  echo "    CFBundleIdentifier = ${BID:-(读不出)}"

  PLIST_BID=$(grep -o '"[^"]*\.[^"]*"' "$DL/PhigrosAuto.plist" 2>/dev/null | tr -d '"' | head -1)
  echo "    plist 里写的      = ${PLIST_BID:-(空)}"
  if [ -n "$BID" ] && [ -n "$PLIST_BID" ] && [ "$BID" != "$PLIST_BID" ]; then
    echo "    !!! 不匹配 —— 这就是没注入的直接原因 !!!"
    BID_MISMATCH=1
  fi
else
  echo "    找不到 Phigros.app，无法读取 bundle id"
fi

# ---------- 结论 ----------
echo
echo "=============================================="
echo " 结论"
echo "=============================================="
if [ "$GAME_UP" = "0" ]; then
  echo " 游戏没开。先打开 Phigros 停在主界面，再跑一次 phprobe。"
elif [ "$INJECTED" = "1" ]; then
  echo " A) dylib 已注入并执行 —— 注入链路正常。"
  if [ -n "$LOGS" ]; then
    echo "    日志在上面第 4 节，看最后几行判断卡在哪。"
  else
    echo "    但日志没写成功，说明是写文件权限问题，看心跳标记即可证明注入 OK。"
  fi
else
  echo " B) dylib 没注入。真正的可疑点按可能性排序："
  echo
  if [ "$BID_MISMATCH" = "1" ]; then
    echo "   ★ 第一位：bundle id 不匹配（见 5b 节）"
    echo "     plist 写的是 $PLIST_BID，游戏实际是 $BID"
    echo "     => 把 plist 改成实际值，或告诉我实际值，我重新打包。"
  fi
  echo "   1. filter plist 内容："
  echo "      cat $DL/PhigrosAuto.plist"
  echo "   2. rootHide 补丁链接（被重定位就没法常规注入）："
  echo "      ls -l $DL/ | grep -i phigros"
  echo "   3. 桌面未重启（注入只发生在进程启动瞬间）："
  echo "      killall -9 SpringBoard"
  echo "   4. 装完后游戏是从后台恢复而不是冷启动："
  echo "      从多任务里彻底划掉 Phigros，再重新打开"
fi
echo "=============================================="
